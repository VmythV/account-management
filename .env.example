HOST=127.0.0.1
PORT=3001
# Paths relative to the project directory.
DATABASE_PATH=./data/accounts.sqlite
AUTH_PATH=./data/access.json
# Keep this key separate from database backups. Losing it makes passwords unrecoverable.
VAULT_KEY_PATH=./data/vault.key
# Set to the exact HTTPS public origin when deploying, without a trailing slash.
# APP_ORIGIN=https://accounts.example.com
